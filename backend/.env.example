GEMINI_API_KEY=""
GEMINI_MODEL=models/gemini-pro-latest
GEMINI_MODEL_FALLBACKS=models/gemini-pro-latest,models/gemini-2.5-flash-image,models/gemini-flash-latest,models/gemini-3.6-flash
# Ollama is optional and runs locally without an API key.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Direct Ollama Cloud access requires an API key from ollama.com.
OLLAMA_API_KEY=""
OLLAMA_CLOUD_MODEL=gpt-oss:120b

GOOGLE_MAPS_API_KEY=""
DATA_GOV_API_KEY=""
API_SETU_CLIENT_ID=""
API_SETU_CLIENT_SECRET=""
HOST=0.0.0.0
PORT=8000

# Used only by the scheduled/offline scheme-catalogue refresh utility.
# The user-facing matcher reads scheme_catalog.json and never calls data.gov.in live.
DATA_GOV_IN_SCHEMES_RESOURCE_ID=""
DATA_GOV_IN_API_KEY=""
